# ═══════════════════════════════════════════════
# Aura Learn V3 — Environment Variables
# Copy this to .env and fill in your values
# ═══════════════════════════════════════════════

# ── Supabase ──────────────────────────────────
# Get these from your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Backend only (never expose this to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Groq (Free tier available) ────────────────
# Sign up at: https://console.groq.com
# Free tier gives you Llama 3 70B access
GROQ_API_KEY=gsk_your-groq-api-key-here

# ── App Config ────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
FRONTEND_URL=http://localhost:3000

# ── Whisper (Local, Free) ─────────────────────
# Options: tiny, base, small, medium, large
# 'base' is recommended for good speed/accuracy balance
# Requires ffmpeg installed: https://ffmpeg.org/download.html
WHISPER_MODEL=base

# ── Frontend ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
